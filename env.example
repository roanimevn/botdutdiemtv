# ====== BẮT BUỘC ======
DISCORD_TOKEN=dán_token_bot_vào_đây

# Địa chỉ website DUTDIEMTV để bot giám sát (có https://)
SITE_URL=https://example.com

# Kênh nhận báo cáo lỗi (chỉ cho staff xem). Bật Developer Mode > chuột phải kênh > Copy Channel ID
STAFF_CHANNEL_ID=0

# ====== NÊN ĐIỀN ======
# ID server (lệnh / cập nhật ngay lập tức). Bỏ trống = đăng ký global (có thể mất tới ~1 giờ)
GUILD_ID=0
# Kênh bot thông báo "web sập" / "web hoạt động trở lại"
ALERT_CHANNEL_ID=0
# Kênh chào thành viên mới
WELCOME_CHANNEL_ID=0
# Role đội ngũ hỗ trợ (được ping khi có báo cáo mới / web sập, và được dùng nút xử lý)
SUPPORT_ROLE_ID=0

# ====== TUỲ CHỌN ======
# URL máy chủ stream để giám sát riêng (để trống nếu không có)
STREAM_CHECK_URL=
# Giây giữa các lần kiểm tra web (tối thiểu 30)
CHECK_INTERVAL=120
# Gửi thêm tin chào qua DM cho thành viên mới
WELCOME_DM=false
# Tự gợi ý cách khắc phục khi thành viên mô tả lỗi trong SUPPORT_CHANNEL_ID
# (cần bật Message Content Intent trong Developer Portal)
ENABLE_AUTOREPLY=false
SUPPORT_CHANNEL_ID=0
